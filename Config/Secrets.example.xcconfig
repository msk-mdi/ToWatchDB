// Copy to Config/Secrets.xcconfig (gitignored) and fill in your TMDB v4 read access token.
// https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN = your_tmdb_v4_read_access_token

// Optional: sign with your team so Siri & Shortcuts actions run (a free Apple ID works).
// DEVELOPMENT_TEAM = ABCDE12345
// CODE_SIGN_IDENTITY = Apple Development

// Optional: a Dropbox app key, for Dropbox sync. Create an app at https://www.dropbox.com/developers/apps
// with "App folder" access and the files.content.read and files.content.write permissions.
// DROPBOX_APP_KEY = your_dropbox_app_key
